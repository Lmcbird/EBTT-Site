import { members } from 'wix-members.v2';

export async function approveMemberInWix(email) {
    try {
        // Find the member by email
        const queryResults = await members.queryMembers()
            .eq("loginEmail", email)
            .find();

        if (queryResults.items.length > 0) {
            const memberId = queryResults.items[0]._id;
            await members.approveMember(memberId);
            
            console.log(`Member with email ${email} officially approved.`);
            return { success: true };
        } else {
            console.log("No member found with that email.");
            return { success: false, error: "Member not found" };
        }
    } catch (error) {
        console.error("Wix System Approval Failed", error);
    }
}