import wixData from 'wix-data';

// ─── RESOURCES ────────────────────────────────────────────

export async function getPublicResources() {
    try {
        const results = await wixData.query("Resources")
            .eq("displayResource", true)
            .ascending("title")
            .find();
        return results.items;
    } catch (error) {
        console.error("Database query failed", error);
        return [];
    }
}

// ─── EVENTS ───────────────────────────────────────────────

export async function submitEvent(eventData) {
    try {
        const inserted = await wixData.insert("Events", {
            title: eventData.title,
            description: eventData.description,
            eventDate: new Date(eventData.eventDate),
            location: eventData.location,
            contactName: eventData.contactName,
            contactEmail: eventData.contactEmail,
            externalLink: eventData.externalLink || null,
            approved: false
        });
        return { success: true, id: inserted._id };
    } catch (error) {
        console.error("Event submission failed:", error);
        return { success: false, error: error.message };
    }
}

export async function getApprovedEvents() {
    try {
        const now = new Date();
        const results = await wixData.query("Events")
            .eq("approved", true)
            .ge("eventDate", now)
            .ascending("eventDate")
            .find();
        return results.items;
    } catch (error) {
        console.error("Events fetch failed:", error);
        return [];
    }
}

export async function approveEvent(eventId) {
    try {
        const item = await wixData.get("Events", eventId);
        if (!item) return { success: false, error: "Event not found" };

        await wixData.update("Events", { ...item, approved: true });
        return { success: true };
    } catch (error) {
        console.error("Approval failed:", error);
        return { success: false, error: error.message };
    }
}

export async function getAllApprovedEvents() {
    try {
        const results = await wixData.query("Events")
            .eq("approved", true)
            .ascending("eventDate")
            .find();
        return results.items;
    } catch (error) {
        console.error("Events fetch failed:", error);
        return [];
    }
}