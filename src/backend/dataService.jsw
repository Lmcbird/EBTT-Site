import wixData from 'wix-data';

export async function getPublicResources() {
    try {
        const results = await wixData.query("Resources")
            .eq("displayResource", true)
            .ascending("title")
            .find();
        return results.items;
    } catch (error) {
        console.error("Database query failed", error);
        return [];
    }
}

// Server-side search across title and description
export async function searchResources(query) {
    try {
        const q = query.trim().toLowerCase();
        const results = await wixData.query("Resources")
            .eq("displayResource", true)
            .contains("title", q)
            .ascending("title")
            .find();
        return results.items;
    } catch (error) {
        console.error("Search query failed", error);
        return [];
    }
}