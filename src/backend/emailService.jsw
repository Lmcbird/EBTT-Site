import { triggeredEmails, members } from 'wix-members-backend';

const ADMIN_EMAIL = "connellyl@duq.edu";
const EMAIL_ID = "eventSubmissionAlert";

export async function sendApprovalEmail(eventData, eventId) {
    try {
        const memberSearchResult = await members.queryMembers()
            .eq("loginEmail", ADMIN_EMAIL)
            .find();

        if (memberSearchResult.items.length === 0) {
            console.error(`Member not found for email: ${ADMIN_EMAIL}. Make sure you are a registered Site Member.`);
            return { success: false, error: "Admin member not found." };
        }

        const memberId = memberSearchResult.items[0]._id;
        const approveLink = `https://connellyl4.wixstudio.com/my-site-2/approve-event?id=${eventId}`;

        await triggeredEmails.emailMember(EMAIL_ID, memberId, {
            variables: {
                eventName: eventData.title,
                eventDate: new Date(eventData.eventDate).toLocaleDateString("en-US", {
                    weekday: "long", year: "numeric", month: "long", day: "numeric"
                }),
                eventLocation: eventData.location,
                contactName: eventData.contactName,
                contactEmail: eventData.contactEmail,
                approveLink: approveLink
            }
        });

        return { success: true };

    } catch (error) {
        console.error("Email send failed:", error);
        return { success: false, error: error.message };
    }
}